{
  "$comment": "JSON Schema draft 2020-12 shape; the $schema URI is intentionally omitted so product fixtures stay free of external URLs.",
  "$id": "chimera.graph.parity.fixture.v1",
  "title": "Chimera graph parity fixture v1",
  "description": "Static input+expectation contract for the six graph faces. Not an execution engine; the W0 recorder/comparator (WP-02/WP-03) consumes these files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_version",
    "contract_rev",
    "id",
    "face",
    "kind",
    "title",
    "input",
    "expect",
    "provenance"
  ],
  "properties": {
    "fixture_version": {
      "const": 1,
      "description": "Format version. Bump only on breaking shape changes."
    },
    "contract_rev": {
      "const": "cr-2026-10-30-r1",
      "description": "Shared contract revision; follows packages/chimera/specs/rust-host/manifest.yaml."
    },
    "id": {
      "type": "string",
      "pattern": "^(extraction|store|resolution|query|traversal|pattern)/(golden|negative)/[a-z0-9][a-z0-9-]*$",
      "description": "Must equal the fixture path relative to test/oracle/graph/ without the .json suffix."
    },
    "face": {
      "enum": ["extraction", "store", "resolution", "query", "traversal", "pattern"]
    },
    "kind": {
      "enum": ["golden", "negative"]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "input": {
      "type": "object",
      "description": "Face-specific input. See packages/chimera/specs/rust-host/graph/parity-fixtures.md §2.2."
    },
    "expect": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": {
          "enum": ["ok", "defer", "error", "empty"]
        },
        "match": {
          "enum": ["exact_after_canonicalization", "subset", "stats_only", "error"]
        },
        "canonicalization": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "required": ["code"],
          "properties": {
            "code": { "type": "string", "minLength": 1 },
            "message_contains": { "type": "string" }
          },
          "additionalProperties": true
        },
        "must_not": {
          "type": "array",
          "items": { "type": "string" }
        },
        "volatile_fields": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "derivation", "executed"],
      "properties": {
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "derivation": {
          "type": "string",
          "minLength": 1
        },
        "executed": {
          "type": "boolean",
          "description": "True when the expectation was derived by running the current TS engine; false when derived from code semantics only."
        },
        "engine": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}