  "description": "合成 3 个 turn 与 2 个旧工具输出；断言 tail 从 m5 开始、仅 t2 被裁剪、裁剪量 30000 超过最小阈值。",
  "input": {
    "messages": [
      {
        "id": "m1",
        "role": "user",
        "tokens": 1000,
        "summary": false
      },
      {
        "id": "m2",
        "role": "assistant",
        "tokens": 1000,
        "summary": false
      },
      {
        "id": "m3",
        "role": "user",
        "tokens": 1000,
        "summary": false
      },
      {
        "id": "m4",
        "role": "assistant",
        "tokens": 1000,
        "summary": false
      },
      {
        "id": "m5",
        "role": "user",
        "tokens": 1000,
        "summary": false
      },
      {
        "id": "m6",
        "role": "assistant",
        "tokens": 1000,
        "summary": false
      }
    ],
    "tailTurns": 2,
    "preserveRecentTokens": 2500,
    "prune": true,
    "toolParts": [
      {
        "id": "t1",
        "messageId": "m2",
        "tool": "read",
        "tokens": 30000,
